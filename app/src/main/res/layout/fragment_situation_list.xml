<?xml version="1.0" encoding="utf-8"?>
<!-- banner and number of results above the list, with data acknowledgement below-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/listNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="2dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp"
        android:textStyle="italic"
        android:visibility="gone" />

    <TextView
        android:id="@+id/listStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/situationRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/listSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="6dp"
        android:text="Contains Traffic Scotland data. Icons: Google Material Icons (Apache License 2.0)"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="11sp" />

</LinearLayout>